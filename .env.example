# Replace this with your Unraid LAN address before starting.
BIND_IP=192.168.1.100
APPDATA_PATH=/mnt/user/appdata/sbtg2cloud
PUID=99
PGID=100

# Optional container-only HTTP proxies. Empty values retain direct connections.
# Telegram does NOT use HTTP_PROXY, HTTPS_PROXY or NO_PROXY.
TELEGRAM_PROXY_URL=
# Guangya HTTPX requests use these standard environment variables.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
# Example (replace proxy.example with your proxy host; do not commit credentials):
# TELEGRAM_PROXY_URL=http://proxy.example:8080
# HTTP_PROXY=http://proxy.example:8080
# HTTPS_PROXY=http://proxy.example:8080
