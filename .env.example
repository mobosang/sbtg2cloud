# Replace this with your Unraid LAN address before starting.
BIND_IP=192.168.1.100
APPDATA_PATH=/mnt/user/appdata/sbtg2cloud
PUID=99
PGID=100

# Optional HTTP CONNECT proxy for Telegram only. Empty means Telegram connects directly.
# Set the real proxy address in your private .env, never in this example or Git.
TELEGRAM_PROXY_URL=
# Example (replace proxy.example with your proxy host; do not commit credentials):
# TELEGRAM_PROXY_URL=http://proxy.example:8080
# Guangya connects directly: compose.yaml clears standard HTTP proxy variables.
